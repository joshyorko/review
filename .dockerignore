# Deny everything, then allow only what the image build actually consumes.
# Keeping this tight stops .git and local state from entering the build
# context.
*
!image/
!image/**
# Reopen the scripts directory; only the explicit files below enter the context.
!scripts/
# The local skill generator consumes this repository's current skill manifest.
!scripts/generate-skills.py
# The appliance build stage generates an SPDX document for OMP, the GitHub CLI,
# and the Review workbench package.
!scripts/generate-appliance-sbom.py
!scripts/build-derived-omp.sh
!scripts/derived-omp-canary.ts
!patches/
!patches/omp/
!patches/omp/memory-backend-registration.patch
!patches/omp/clipboard-truthful-18.5.0.patch
**/__pycache__/
**/*.pyc
