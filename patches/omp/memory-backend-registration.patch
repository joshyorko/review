+import type { AgentSession } from "../session/agent-session";
+import type { MemoryBackendRegistration } from "./types";
+
+const BUILTIN_IDS = new Set(["off", "local", "hindsight", "mnemopi", "sharpshooter"]);
+type OwnedRegistration = { owner: string; registration: MemoryBackendRegistration };
+type PendingRegistration = { sourceId: string; registration: MemoryBackendRegistration };
+const sessionRegistrations = new WeakMap<AgentSession, Map<string, OwnedRegistration>>();
+
+export function validateMemoryBackendRegistration(registration: MemoryBackendRegistration): void {
+	if (!/^[a-zA-Z0-9][a-zA-Z0-9._-]*$/.test(registration.id)) {
+		throw new TypeError(`Invalid memory backend id: ${registration.id}`);
+	}
+	if (BUILTIN_IDS.has(registration.id)) {
+		throw new Error(`Memory backend id is reserved by OMP: ${registration.id}`);
+	}
+	if (typeof registration.create !== "function") {
+		throw new TypeError(`Memory backend ${registration.id} must provide a factory`);
+	}
+	const settingIds = new Set<string>();
+	for (const setting of registration.settings) {
+		if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(setting.id) || settingIds.has(setting.id)) {
+			throw new TypeError(`Memory backend ${registration.id} has an invalid or duplicate setting id`);
+		}
+		if (!["string", "boolean", "number"].includes(setting.type)) {
+			throw new TypeError(`Memory backend ${registration.id} has an unsupported setting type: ${setting.type}`);
+		}
+		if (setting.default !== undefined && typeof setting.default !== setting.type) {
+			throw new TypeError(`Memory backend ${registration.id} setting "${setting.id}" has an invalid default type`);
+		}
+		if (setting.required !== undefined && typeof setting.required !== "boolean") {
+			throw new TypeError(`Memory backend ${registration.id} setting "${setting.id}" has an invalid required flag`);
+		}
+		settingIds.add(setting.id);
+	}
+}
+
+/** Bind only this AgentSession's successfully loaded extension registrations. */
+export function bindMemoryBackendRegistrations(
+	session: AgentSession,
+	pending: readonly PendingRegistration[],
+): void {
+	const registrations = new Map<string, OwnedRegistration>();
+	for (const { registration, sourceId } of pending) {
+		validateMemoryBackendRegistration(registration);
+		if (registrations.has(registration.id)) {
+			throw new Error(`Memory backend ${registration.id} is registered more than once by ${sourceId}`);
+		}
+		registrations.set(registration.id, { owner: sourceId, registration });
+	}
+	sessionRegistrations.set(session, registrations);
+}
+
+export function getMemoryBackendRegistration(
+	id: string,
+	session: AgentSession,
+): MemoryBackendRegistration | undefined {
+	return sessionRegistrations.get(session)?.get(id)?.registration;
+}
+/** Release the extension registrations after this session is disposed. */
+export function unbindMemoryBackendRegistrations(session: AgentSession): void {
+	sessionRegistrations.delete(session);
+}
