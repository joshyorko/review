+				parent: options.parentMnemopiSessionState ?? options.parentHindsightSessionState,
+			});
+		},
+		buildDeveloperInstructions(agentDir, _settings, session) {
+			return instance.buildDeveloperInstructions(agentDir, factoryContext.settings, session);
+		},
+		clear(agentDir, cwd, session) {
+			return instance.clear(agentDir, cwd, session);
+		},
+		enqueue(agentDir, cwd, session) {
+			return instance.enqueue(agentDir, cwd, session);
+		},
+	};
+	if (instance.dispose) backend.dispose = instance.dispose.bind(instance);
+	const status = instance.status;
+	if (status) backend.status = (context: MemoryBackendOperationContext): Promise<MemoryBackendStatus> => status.call(instance, context);
+	const search = registration.capabilities.search ? instance.search : undefined;
+	if (search) {
+		backend.search = (
+			context: MemoryBackendOperationContext,
+			query: string,
+			options?: MemoryBackendSearchOptions,
+			): Promise<MemoryBackendSearchResult> => search.call(instance, context, query, options);
+	}
+	const save = registration.capabilities.explicitSave ? instance.save : undefined;
+	if (save) {
+		backend.save = (
+			context: MemoryBackendOperationContext,
+			input: MemoryBackendSaveInput,
+		): Promise<MemoryBackendSaveResult> => save.call(instance, context, input);
+	}
+	const beforeAgentStartPrompt = registration.capabilities.recall ? instance.beforeAgentStartPrompt : undefined;
+	if (beforeAgentStartPrompt) {
+		backend.beforeAgentStartPrompt = (
+			session: AgentSession,
+			promptText: string,
+			signal?: AbortSignal,
+		): Promise<MemoryPromptPreparation | undefined> => beforeAgentStartPrompt.call(instance, session, promptText, signal);
+	}
+	const preCompactionContext = registration.capabilities.compactionRecall ? instance.preCompactionContext : undefined;
+	if (preCompactionContext) {
+		backend.preCompactionContext = (
+			messages: readonly unknown[],
+			_settings: Settings,
+			session?: AgentSession,
+		): Promise<string | undefined> => preCompactionContext.call(instance, messages, factoryContext.settings, session);
+	}
+	return backend;
+}
+
+function unavailableBackend(id: MemoryBackendId, message: string): MemoryBackend {
+	return {
+		id,
+		async start() {},
+		async buildDeveloperInstructions() {
+			return undefined;
+		},
+		async clear() {},
+		async enqueue() {},
+		async status() {
+			return { backend: id, active: false, writable: false, searchable: false, message, error: message };
+		},
+		async search(_context, query) {
+			return { backend: id, query, count: 0, items: [], message };
+		},
+		async save() {
+			return { backend: id, stored: 0, message };
+		},
+	};
+}
+/** Dispose every instance cached for a session before a backend transition. */
+export async function disposeRegisteredMemoryBackendInstances(session: AgentSession): Promise<void> {
+	const instances = backendInstances.get(session);
+	if (!instances) return;
+	backendInstances.delete(session);
+	const results = await Promise.allSettled(
+		Array.from(instances.values(), ({ backend }) => Promise.resolve().then(() => backend.dispose?.())),
+	);
+	const errors = results
+		.filter((result): result is PromiseRejectedResult => result.status === "rejected")
+		.map(result => result.reason);
+	if (errors.length > 0) throw new AggregateError(errors, "Failed to dispose registered memory backends");
+}
+
+/** Dispose cached instances and unbind registrations when a session closes. */
+export async function releaseRegisteredMemoryBackendSession(session: AgentSession): Promise<void> {
+	try {
+		await disposeRegisteredMemoryBackendInstances(session);
+	} finally {
+		unbindMemoryBackendRegistrations(session);
+	}
 }
