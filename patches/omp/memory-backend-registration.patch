+	const perBackendSettings = cfgMemoryBackendSettings.get(settings);
+	const configuredValue =
+		settings.getProvenance(cfgMemoryBackendSettings) === "project" || !Object.hasOwn(perBackendSettings, id)
+			? undefined
+			: perBackendSettings[id];
+	if (
+		configuredValue !== undefined &&
+		(configuredValue === null || typeof configuredValue !== "object" || Array.isArray(configuredValue))
+	) {
+		return unavailableBackend(id, `Memory backend "${id}" settings must be a record`);
+	}
+	const configured: Readonly<Record<string, unknown>> = configuredValue ?? EMPTY_SETTINGS;
+	const backendSettings: Record<string, unknown> = {};
+	for (const setting of registration.settings) {
+		const value = Object.hasOwn(configured, setting.id) ? configured[setting.id] : setting.default;
+		if (value === undefined && setting.required) {
+			return unavailableBackend(id, `Memory backend "${id}" requires setting "${setting.id}"`);
+		}
+		if (value !== undefined && typeof value !== setting.type) {
+			return unavailableBackend(id, `Memory backend "${id}" setting "${setting.id}" must be ${setting.type}`);
+		}
