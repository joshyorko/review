+function adaptRegisteredBackend(
+	registration: MemoryBackendRegistration,
+	instance: RegisteredMemoryBackendInstance,
+	factoryContext: RegisteredMemoryBackendContext,
+): MemoryBackend {
+	const backend: MemoryBackend = {
