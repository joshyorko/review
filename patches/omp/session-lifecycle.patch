@@ -0,0 +1,262 @@
+import { afterEach, describe, expect, it, vi } from "bun:test";
+import * as path from "node:path";
+import { Agent } from "@oh-my-pi/pi-agent-core";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { AsyncJobManager } from "../src/async/job-manager";
+import { resetSettingsForTest, Settings } from "../src/config/settings";
+import { ModelRegistry } from "../src/config/model-registry";
+import { ExtensionRuntime, loadExtensionFromFactory } from "../src/extensibility/extensions/loader";
+import { ExtensionRunner, testSetExtensionHandlerTimeoutMs } from "../src/extensibility/extensions/runner";
+import type { ExtensionAPI } from "../src/extensibility/extensions/types";
+import type { SessionShutdownSettledEvent } from "../src/extensibility/shared-events";
+import { Shell, type ShellRunResult } from "@oh-my-pi/pi-natives";
+import { executeBash, settleShellSessions } from "../src/exec/bash-executor";
+import { EvalRunner } from "../src/session/eval-runner";
+import { AgentSession } from "../src/session/agent-session";
+import { SessionManager } from "../src/session/session-manager";
+import { InteractiveMode } from "../src/modes/interactive-mode";
+import { EventBus } from "../src/utils/event-bus";
+import { TempDir } from "@oh-my-pi/pi-utils";
+import { initTheme } from "@oh-my-pi/pi-tui/theme";
+import { createInMemoryAuthStorage } from "./helpers/agent-session-setup";
+
+const cleanups: Array<() => Promise<void>> = [];
+afterEach(async () => {
+	testSetExtensionHandlerTimeoutMs(30_000);
+	for (const cleanup of cleanups.splice(0)) await cleanup();
+	vi.restoreAllMocks();
+	resetSettingsForTest();
+});
+async function fixture(options: { owned?: AsyncJobManager; shared?: AsyncJobManager; hooks?: (pi: ExtensionAPI) => void } = {}) {
+	const dir = TempDir.createSync("session-exit-");
+	const auth = createInMemoryAuthStorage();
+	const store = SessionManager.inMemory(dir.path());
+	const registry = new ModelRegistry(auth, path.join(dir.path(), "models.yml"));
+	const runtime = new ExtensionRuntime();
+	const receipts: SessionShutdownSettledEvent[] = [];
+	const ordering: string[] = [];
+	const ext = await loadExtensionFromFactory(pi => {
+		pi.on("session_shutdown", () => { ordering.push("shutdown"); });
+		pi.on("session_shutdown_settled", event => {
+			receipts.push(event);
+			store.appendCustomEntry("settlement", event);
+			ordering.push("settled");
+		});
+		options.hooks?.(pi);
+	}, dir.path(), new EventBus(), runtime, "exit-test");
+	const runner = new ExtensionRunner([ext], runtime, dir.path(), store, registry);
+	const mock = createMockModel({ handler: () => ({ content: ["ok"] }) });
+	const session = new AgentSession({
+		agent: new Agent({ initialState: { model: getBundledModel("anthropic", "claude-sonnet-4-5")!, systemPrompt: ["test"], tools: [] }, streamFn: mock.stream }),
+		sessionManager: store, modelRegistry: registry, settings: Settings.isolated(), extensionRunner: runner,
+		agentId: "Main", ownedAsyncJobManager: options.owned, asyncJobManager: options.shared,
+	});
+	const originalClose = store.close.bind(store);
+	vi.spyOn(store, "close").mockImplementation(async () => { ordering.push("close"); await originalClose(); });
+	cleanups.push(async () => { await session.dispose(); auth.close(); dir.removeSync(); });
+	return { session, store, runner, receipts, ordering };
+}
+
+describe("session exit lifecycle", () => {
+	it("persists one positive receipt before closing storage on concurrent noninteractive zero-job exit", async () => {
+		let prompts = 0;
+		const f = await fixture({ hooks: pi => pi.on("session_before_shutdown", () => { prompts++; return { cancel: true }; }) });
+		await Promise.all([f.session.dispose(), f.session.dispose()]);
+		expect(prompts).toBe(0);
+		expect(f.receipts).toEqual([{ type: "session_shutdown_settled", sessionId: f.store.getSessionId(), settled: true, reason: undefined, pendingJobIds: [] }]);
+		expect(f.ordering).toEqual(["shutdown", "settled", "close"]);
+	});
+	for (const count of [1, 3]) it(`waits for ${count} actual job promises after cancellation before the receipt`, async () => {
+		const manager = new AsyncJobManager({ maxRunningJobs: 4 });
+		const release = Promise.withResolvers<void>();
+		const aborted = Promise.withResolvers<void>();
+		let cancelled = 0;
+		for (let i = 0; i < count; i++) manager.register("task", `child ${i}`, async ({ signal }) => {
+			signal.addEventListener("abort", () => { if (++cancelled === count) aborted.resolve(); }, { once: true });
+			await release.promise;
+			return "stopped";
+		}, { ownerId: "Main" });
+		const f = await fixture({ owned: manager });
+		const disposal = f.session.dispose();
+		await aborted.promise;
+		expect(manager.getAllJobs().every(job => job.status === "cancelled")).toBe(true);
+		expect(f.receipts).toEqual([]);
+		release.resolve();
+		await disposal;
+		expect(f.receipts[0]?.settled).toBe(true);
+		expect(f.receipts[0]?.pendingJobIds).toEqual([]);
+	});
+	it("retains the exact pending job ID when cancellation times out, even after manager clears its rows", async () => {
+		const manager = new AsyncJobManager({ maxRunningJobs: 1 });
+		const release = Promise.withResolvers<void>();
+		const id = manager.register("task", "ignores cancellation", async () => { await release.promise; return "late"; }, { ownerId: "Main" });
+		const f = await fixture({ owned: manager });
+		try {
+			await f.session.dispose();
+			expect(f.receipts[0]?.settled).toBe(false);
+			expect(f.receipts[0]?.pendingJobIds).toEqual([id]);
+			expect(f.receipts[0]?.reason).toContain("async jobs");
+		} finally { release.resolve(); }
+		await Promise.resolve();
+		expect(f.receipts).toHaveLength(1);
+	}, 10_000);
+	it("does not certify another session's manager", async () => {
+		const shared = new AsyncJobManager({ maxRunningJobs: 1 });
+		const f = await fixture({ shared });
+		await f.session.dispose();
+		expect(f.receipts[0]?.settled).toBe(false);
+		expect(f.receipts[0]?.reason).toContain("manager not owned");
+		await shared.dispose();
+	});
+	it("does not hide a child's unproven eval teardown behind its settled task promise", async () => {
+		const manager = new AsyncJobManager({ maxRunningJobs: 1 });
+		const child = await fixture({ shared: manager });
+		const parent = await fixture({ owned: manager });
+		const evalDispose = vi.spyOn(EvalRunner.prototype, "disposeKernels").mockResolvedValueOnce(false);
+		await child.session.dispose();
+		evalDispose.mockRestore();
+		await parent.session.dispose();
+		expect(parent.receipts[0]?.settled).toBe(false);
+		expect(parent.receipts[0]?.reason).toContain(child.store.getSessionId());
+		expect(parent.receipts[0]?.reason).toContain("eval execution");
+	});
+	it("does not certify an eval disposal that returns an execution timeout", async () => {
+		vi.spyOn(EvalRunner.prototype, "disposeKernels").mockResolvedValue(false);
+		const f = await fixture();
+		await f.session.dispose();
+		expect(f.receipts[0]?.settled).toBe(false);
+		expect(f.receipts[0]?.reason).toContain("eval execution");
+	});
+	it("certifies a completed native shell command without leaving every shell invocation unproven", async () => {
+		const f = await fixture();
+		const result = await executeBash("printf settled", { sessionKey: f.store.getSessionId() });
+		expect(result.exitCode).toBe(0);
+		await f.session.dispose();
+		expect(f.receipts[0]?.settled).toBe(true);
+	});
+	it("aborts user bash and waits for its result writer before notifying extensions", async () => {
+		const f = await fixture();
+		const started = Promise.withResolvers<void>();
+		const command = f.session.executeBash("printf ready; sleep 20", () => started.resolve());
+		await started.promise;
+		await f.session.dispose();
+		const result = await command;
+		expect(result.cancelled).toBe(true);
+		expect(f.receipts[0]?.settled).toBe(true);
+		expect(f.ordering).toEqual(["shutdown", "settled", "close"]);
+	}, 10_000);
+	it("keeps post-prompt timeout unproven even when the foreground agent is idle", async () => {
+		const f = await fixture();
+		const gate = Promise.withResolvers<void>();
+		f.session.trackPostPromptTaskForTests(gate.promise);
+		try {
+			await f.session.dispose();
+			expect(f.receipts[0]?.settled).toBe(false);
+			expect(f.receipts[0]?.reason).toContain("post-prompt");
+		} finally { gate.resolve(); }
+	}, 10_000);
+	it("reports a rejected owned-manager teardown as unproven", async () => {
+		const owned = new AsyncJobManager({ maxRunningJobs: 1 });
+		vi.spyOn(owned, "dispose").mockRejectedValue(new Error("failed"));
+		const f = await fixture({ owned });
+		await f.session.dispose();
+		expect(f.receipts[0]?.settled).toBe(false);
+	});
+	for (const reason of ["shutdown", "restart"] as const) it(`Stay vetoes ${reason} before disposal, including concurrent requests`, async () => {
+		initTheme();
+		await Settings.init({ inMemory: true });
+		const answer = Promise.withResolvers<{ cancel: boolean }>();
+		let prompts = 0;
+		let cancelled = 0;
+		const f = await fixture({
+			hooks: pi => {
+				pi.on("session_before_shutdown", () => { prompts++; return answer.promise; });
+				pi.on("session_shutdown_cancelled", () => { cancelled++; });
+			}
+		});
+		const mode = new InteractiveMode(f.session, "test");
+		mode.ui.requestRender = () => { };
+		mode.shutdownRequested = true;
+		const first = mode[reason]();
+		await mode[reason]();
+		expect(prompts).toBe(1);
+		answer.resolve({ cancel: true });
+		await first;
+		expect(f.session.isDisposed).toBe(false);
+		expect(mode.isShuttingDown).toBe(false);
+		expect(mode.shutdownRequested).toBe(false);
+		expect(cancelled).toBe(1);
+		await mode[reason]();
+		expect(prompts).toBe(2);
+		expect(f.receipts).toEqual([]);
+	});
+	it("vetoes exit on handler error and timeout rather than treating missing consent as approval", async () => {
+		const error = await fixture({ hooks: pi => pi.on("session_before_shutdown", () => { throw new Error("UI failed"); }) });
+		expect(await error.runner.emit({ type: "session_before_shutdown", sessionId: error.store.getSessionId(), reason: "shutdown" })).toEqual({ cancel: true });
+		testSetExtensionHandlerTimeoutMs(10);
+		const timeout = await fixture({ hooks: pi => pi.on("session_before_shutdown", () => new Promise(() => { })) });
+		expect(await timeout.runner.emit({ type: "session_before_shutdown", sessionId: timeout.store.getSessionId(), reason: "shutdown" })).toEqual({ cancel: true });
+	});
+});
+
+
+describe("native shell exit ownership", () => {
+	for (const reuseAfterEviction of [false, true]) it(reuseAfterEviction
+		? "keeps an older unresolved native run after quarantine eviction and key reuse"
+		: "waits for a concurrent one-shot native run after its JS cancellation result", async () => {
+			const f = await fixture();
+			const runs = [Promise.withResolvers<ShellRunResult>(), Promise.withResolvers<ShellRunResult>()];
+			const starts = [Promise.withResolvers<void>(), Promise.withResolvers<void>()];
+			let calls = 0;
+			vi.spyOn(Shell.prototype, "run").mockImplementation(() => {
+				const index = calls++;
+				starts[index]!.resolve();
+				return runs[index]!.promise;
+			});
+			vi.spyOn(Shell.prototype, "abort").mockResolvedValue();
+			vi.spyOn(Shell.prototype, "liveBackgroundJobCount").mockResolvedValue(0);
+			const abort1 = new AbortController();
+			const first = executeBash("first", { sessionKey: f.store.getSessionId(), signal: abort1.signal });
+			await starts[0]!.promise;
+			if (reuseAfterEviction) {
+				vi.useFakeTimers();
+				abort1.abort();
+				await first;
+				vi.advanceTimersByTime(30_001);
+				await Promise.resolve();
+				vi.useRealTimers();
+			}
+			const abort2 = new AbortController();
+			const second = executeBash("second", { sessionKey: f.store.getSessionId(), signal: abort2.signal });
+			await starts[1]!.promise;
+			abort1.abort();
+			abort2.abort();
+			await Promise.all([first, second]);
+			let settled = false;
+			const proof = settleShellSessions(f.store.getSessionId()).then(value => { settled = true; return value; });
+			const complete = { exitCode: 0, cancelled: false, timedOut: false };
+			runs[reuseAfterEviction ? 1 : 0]!.resolve(complete);
+			await Bun.sleep(0);
+			expect(settled).toBe(false);
+			runs[reuseAfterEviction ? 0 : 1]!.resolve(complete);
+			expect(await proof).toBe(true);
+		});
+	it("never promotes a rejected native abort cleanup to positive settlement", async () => {
+		const f = await fixture();
+		const run = Promise.withResolvers<ShellRunResult>();
+		const started = Promise.withResolvers<void>();
+		vi.spyOn(Shell.prototype, "run").mockImplementation(() => { started.resolve(); return run.promise; });
+		vi.spyOn(Shell.prototype, "abort").mockRejectedValueOnce(new Error("native abort failed")).mockResolvedValue();
+		vi.spyOn(Shell.prototype, "liveBackgroundJobCount").mockResolvedValue(0);
+		const abort = new AbortController();
+		const result = executeBash("pending", { sessionKey: f.store.getSessionId(), signal: abort.signal });
+		await started.promise;
+		abort.abort();
+		await result;
+		run.resolve({ exitCode: 0, cancelled: false, timedOut: false });
+		expect(await settleShellSessions(f.store.getSessionId())).toBe(false);
+		await f.session.dispose();
+		expect(f.receipts[0]?.settled).toBe(false);
+	});
+});
