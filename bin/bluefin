#!/usr/bin/env bash
# Launch an isolated Bluefin appliance, preferring a libkrun KVM microVM.
set -euo pipefail

command_name="${1:-}"
shift || true
script_path="$(readlink -f "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script_path")/.." && pwd)"
engine=podman
KVM_FAILURE=""

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

kvm_runtime_ready() {
  local device="${REVIEW_TEST_KVM_DEVICE:-/dev/kvm}"
  if ! command -v "$engine" >/dev/null 2>&1; then KVM_FAILURE="Podman is unavailable"; return 1; fi
  if ! "$engine" info >/dev/null 2>&1; then KVM_FAILURE="Podman is not reachable"; return 1; fi
  local selected="${CONTAINER_HOST:-}" connections name uri is_default
  if [[ -z "$selected" ]]; then
    connections="$("$engine" system connection list --format '{{.Name}}\t{{.URI}}\t{{.Default}}' 2>/dev/null)" || {
      KVM_FAILURE="Podman connections could not be resolved"
      return 1
    }
    while IFS=$'\t' read -r name uri is_default; do
      if [[ -n "${CONTAINER_CONNECTION:-}" && "$name" == "$CONTAINER_CONNECTION" ]] ||
        [[ -z "${CONTAINER_CONNECTION:-}" && "$is_default" == true ]]; then
        selected="$uri"
        break
      fi
    done <<<"$connections"
    if [[ -n "${CONTAINER_CONNECTION:-}" && -z "$selected" ]]; then
      KVM_FAILURE="the selected Podman connection could not be resolved"
      return 1
    fi
  fi
  if [[ -n "$selected" && "$selected" != unix://* ]]; then
    KVM_FAILURE="remote Podman engines are unsupported by the packaged launcher"
    return 1
  fi
  if ! command -v krun >/dev/null 2>&1; then KVM_FAILURE="the krun OCI runtime is unavailable"; return 1; fi
  if [[ ! -r "$device" || ! -w "$device" ]]; then KVM_FAILURE="${device} is not readable and writable"; return 1; fi
  return 0
}

apptainer_fallback_ready() {
  local fuse_device="${REVIEW_TEST_FUSE_DEVICE:-/dev/fuse}"
  command -v apptainer >/dev/null 2>&1 || { APPTAINER_FAILURE="Apptainer fallback is unavailable; install Apptainer"; return 1; }
  { command -v squashfuse_ll >/dev/null 2>&1 || command -v squashfuse >/dev/null 2>&1; } || {
    APPTAINER_FAILURE="squashfuse userland is unavailable; install squashfuse"
    return 1
  }
  test -e "$fuse_device" || { APPTAINER_FAILURE="FUSE device ${fuse_device} is missing"; return 1; }
  test -c "$fuse_device" || { APPTAINER_FAILURE="FUSE device ${fuse_device} is not a character device"; return 1; }
  if ! test -r "$fuse_device" || ! test -w "$fuse_device"; then
    APPTAINER_FAILURE="FUSE device ${fuse_device} is not readable and writable"
    return 1
  fi
  return 0
}
require_fallback() {
  apptainer_fallback_ready || fail "${KVM_FAILURE}; ${APPTAINER_FAILURE}."
  echo "WARNING: ${KVM_FAILURE}; using the isolated Apptainer fallback without a KVM boundary." >&2
}
prepare_apptainer_environment() {
  local name host_file
  for name in GH_TOKEN GITHUB_TOKEN COPILOT_GITHUB_TOKEN GITHUB_COPILOT_TOKEN COPILOT_INTEGRATION_ID ANTHROPIC_API_KEY ANTHROPIC_OAUTH_TOKEN OPENAI_API_KEY GEMINI_API_KEY AWS_BEARER_TOKEN_BEDROCK AWS_REGION AWS_DEFAULT_REGION HIVE_HUB BLUEFIN_REVIEW_ORG BLUEFIN_REVIEW_PERSONAL_MODE BLUEFIN_REVIEW_SHOW_WORKFLOW_PRS BLUEFIN_REVIEW_INHERIT_OMP_CONFIG TERM COLORTERM; do
    [[ -v "$name" ]] && export "APPTAINERENV_${name}=${!name}"
  done
  APPTAINER_HOST_ARGS=()
  for host_file in /etc/localtime /etc/hosts; do
    test -e "$host_file" || APPTAINER_HOST_ARGS+=(--no-mount "$host_file")
  done
  return 0
}

detect_review_audio() {
  local runtime_dir="${REVIEW_TEST_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}}"
  local pulse_socket="${runtime_dir}/pulse/native"
  local snd_device="${REVIEW_TEST_SND_DEVICE:-/dev/snd}"
  local pulse_cookie="${PULSE_COOKIE:-${XDG_CONFIG_HOME:-${HOME:-/no-such-home}/.config}/pulse/cookie}"
  if [[ "${PULSE_SERVER:-}" == unix:* && -S "${PULSE_SERVER#unix:}" ]]; then
    pulse_socket="${PULSE_SERVER#unix:}"
  fi

  REVIEW_AUDIO_PULSE_SOCKET=""
  REVIEW_AUDIO_PULSE_SERVER=""
  REVIEW_AUDIO_PULSE_COOKIE=""
  REVIEW_AUDIO_SND_DEVICE=""

  if [[ -S "$pulse_socket" ]]; then
    REVIEW_AUDIO_PULSE_SOCKET="$pulse_socket"
    REVIEW_AUDIO_PULSE_SERVER="unix:/run/bluefin/pulse/native"
    [[ -r "$pulse_cookie" ]] && REVIEW_AUDIO_PULSE_COOKIE="$pulse_cookie"
    return 0
  fi
  if [[ -d "$snd_device" ]]; then
    REVIEW_AUDIO_SND_DEVICE="$snd_device"
    return 0
  fi
}

prepare_review_omp_mount() {
  REVIEW_OMP_CONFIG_VOLUME=""
  REVIEW_OMP_WARNING=""
  if [[ "${BLUEFIN_REVIEW_INHERIT_OMP_CONFIG:-0}" == 1 ]]; then
    local host_omp="${HOME:-/no-such-home}/.omp"
    if [[ -d "$host_omp" ]]; then
      REVIEW_OMP_CONFIG_VOLUME="$host_omp:/home/bluefin/.omp:rw"
    else
      REVIEW_OMP_WARNING="WARNING: BLUEFIN_REVIEW_INHERIT_OMP_CONFIG=1 was requested, but ${host_omp} is absent; using appliance-owned OMP state."
    fi
  fi
}

image_ref_is_moving() {
  case "$1" in
    *@sha256:*|*:sha-*|localhost/*) return 1 ;;
    */*) return 0 ;;
  esac
  ! "$engine" image exists "localhost/$1"
}
ensure_image() {
  local ref="$1" product="$2" containerfile="$3" override="$4"
  if image_ref_is_moving "$ref"; then
    "$engine" pull "$ref" && return 0
    if "$engine" image exists "$ref"; then
      echo "! could not refresh ${ref}; using the local copy, which may be out of date." >&2
      return 0
    fi
  fi
  "$engine" image exists "$ref" && return 0
  case "$ref" in
    localhost/*)
      echo "ERROR: ${ref} is a locally built image and it is not in local storage." >&2
      echo "  Build it from a review checkout: podman build -f ${containerfile} -t ${ref#localhost/} ." >&2
      echo "  Or drop the override to use the published default: unset ${override}" >&2
      return 1
      ;;
  esac
  "$engine" pull "$ref" && return 0
  echo "ERROR: cannot obtain ${product} image ${ref}." >&2
  echo "  Set ${override} to a published tag or digest." >&2
  return 1
}

report_podman_image_identity() {
  local ref="$1" product="$2" identity version revision digest
  identity="$("$engine" image inspect --format '{{ index .Config.Labels "org.opencontainers.image.version" }}|{{ index .Config.Labels "org.opencontainers.image.revision" }}|{{ .Digest }}' "$ref" 2>/dev/null)" || {
    echo "! ${product} image identity unavailable for ${ref}." >&2
    return 0
  }
  IFS='|' read -r version revision digest <<<"$identity"
  [[ -n "$version" && "$version" != "<no value>" ]] || version=unknown
  [[ -n "$revision" && "$revision" != "<no value>" ]] || revision=unknown
  [[ -n "$digest" && "$digest" != "<no value>" ]] || digest=unknown
  echo "✓ ${product} image ${ref}: version=${version} revision=${revision} digest=${digest}" >&2
}


slugify() {
  local value="$1" slug digest
  slug="$(printf '%s' "$value" | tr '[:upper:]/:' '[:lower:]--' | tr -cd 'a-z0-9_.-')"
  slug="${slug:0:28}"
  [[ -n "$slug" ]] || slug=default
  digest="$(printf '%s' "$value" | sha256sum | cut -c1-8)"
  printf '%s-%s\n' "$slug" "$digest"
}

read_env_value() {
  local wanted="$1" file="$2" key value
  while IFS='=' read -r key value; do
    key="${key#export }"
    key="${key//[[:space:]]/}"
    [[ "$key" == "$wanted" ]] || continue
    value="${value#\"}"
    value="${value%\"}"
    value="${value#\'}"
    value="${value%\'}"
    printf '%s\n' "$value"
    return 0
  done <"$file"
}

resolve_tokens() {
  if [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
    GH_TOKEN="$(gh auth token 2>/dev/null || true)"
    export GH_TOKEN
  fi
  if [[ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]] && command -v python3 >/dev/null 2>&1; then
    GH_TOKEN="$(python3 -c '
import sqlite3, os, json
state_dir = os.environ.get("BLUEFIN_OMP_STATE") or os.path.expanduser("~/.omp")
db_path = os.path.join(state_dir, "agent/agent.db")
if os.path.exists(db_path):
    try:
        connection = sqlite3.connect(db_path)
        for provider in ("github-copilot", "github"):
            row = connection.execute("SELECT data FROM auth_credentials WHERE provider = ?", (provider,)).fetchone()
            if row:
                data = json.loads(row[0])
                token = data.get("access") or data.get("token") or data.get("access_token")
                if token:
                    print(token)
                    break
    except Exception:
        pass
' 2>/dev/null || true)"
    export GH_TOKEN
  fi
  export GH_TOKEN="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  export GITHUB_TOKEN="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
  export COPILOT_GITHUB_TOKEN="${COPILOT_GITHUB_TOKEN:-${GH_TOKEN:-}}"
  export GITHUB_COPILOT_TOKEN="${GITHUB_COPILOT_TOKEN:-${COPILOT_GITHUB_TOKEN:-}}"
  export COPILOT_INTEGRATION_ID="${COPILOT_INTEGRATION_ID:-copilot-developer-cli}"
}

review_args() {
  if [[ -f "$repo_root/scripts/parse-review-args.sh" ]]; then
    # shellcheck source=scripts/parse-review-args.sh
    source "$repo_root/scripts/parse-review-args.sh"
    parse_review_args "$@"
    return
  fi

  PARSED_REVIEW_ARGS=("$@")
  if [[ ${#PARSED_REVIEW_ARGS[@]} -gt 0 && "${PARSED_REVIEW_ARGS[0]}" =~ ^([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)$ ]]; then
    local repository="${BASH_REMATCH[1]}"
    PARSED_REVIEW_ARGS=("${PARSED_REVIEW_ARGS[@]:1}")
    local -a fallback_args=(--repo "$repository")
    if [[ ${#PARSED_REVIEW_ARGS[@]} -gt 0 && "${PARSED_REVIEW_ARGS[0]}" =~ ^#?([0-9]+)$ ]]; then
      fallback_args+=(--pr "${BASH_REMATCH[1]}")
      PARSED_REVIEW_ARGS=("${PARSED_REVIEW_ARGS[@]:1}")
    fi
    PARSED_REVIEW_ARGS=("${fallback_args[@]}" "${PARSED_REVIEW_ARGS[@]}")
  fi
}

run_review() {
  resolve_tokens
  if [[ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]]; then
    echo "WARNING: no GitHub credential found; the queue will load empty." >&2
    echo "  Run 'gh auth login' or export GH_TOKEN." >&2
  fi
  if [[ -z "${HIVE_HUB:-}" && -f "${HOME}/.config/hive/contributor.env" ]]; then
    HIVE_HUB="$(read_env_value HIVE_HUB "${HOME}/.config/hive/contributor.env")"
    export HIVE_HUB
  fi

  review_args "$@"
  local scope=projectbluefin arg previous=""
  for arg in "${PARSED_REVIEW_ARGS[@]}"; do
    if [[ "$previous" == --repo ]]; then scope="$arg"; break; fi
    previous="$arg"
  done

  local key root home workspace scratch name image sif fallback_sif
  key="$(slugify "${BLUEFIN_INSTANCE:-review-$scope}")"
  root="${XDG_STATE_HOME:-${HOME}/.local/state}/bluefin/instances/${key}"
  home="${root}/home"
  workspace="${root}/workspace"
  scratch="${root}/tmp"
  name="bluefin-review-${key}-$(date +%s)-$$"
  image="${BLUEFIN_REVIEW_IMAGE:-ghcr.io/projectbluefin/review:stable}"
  sif="${BLUEFIN_REVIEW_SIF:-}"
  fallback_sif="${BLUEFIN_REVIEW_FALLBACK_SIF:-}"
  mkdir -p "$home/.omp" "$home/.config/pulse" "$workspace" "$scratch"
  detect_review_audio
  prepare_review_omp_mount
  [[ -z "$REVIEW_OMP_WARNING" ]] || echo "$REVIEW_OMP_WARNING" >&2

  launch_sif() {
    local selected_sif="$1"
    command -v apptainer >/dev/null 2>&1 || fail "Apptainer is required for the packaged Review SIF."
    [[ -x "$selected_sif" ]] || fail "review SIF is missing or not executable: ${selected_sif}"
    KVM_FAILURE="the packaged Review SIF was selected"
    require_fallback
    prepare_apptainer_environment
    [[ -z "$REVIEW_AUDIO_PULSE_SERVER" ]] ||
      export APPTAINERENV_PULSE_SERVER="$REVIEW_AUDIO_PULSE_SERVER"
    local -a sif_args=(run --containall --no-eval)
    sif_args+=("${APPTAINER_HOST_ARGS[@]}")
    sif_args+=(--home "${home}:/home/bluefin" --pwd /workspace --bind "${workspace}:/workspace,${scratch}:/tmp")
    if [[ -n "$REVIEW_AUDIO_PULSE_SOCKET" ]]; then
      sif_args+=(--bind "${REVIEW_AUDIO_PULSE_SOCKET}:/run/bluefin/pulse/native")
      [[ -z "$REVIEW_AUDIO_PULSE_COOKIE" ]] ||
        sif_args+=(--bind "${REVIEW_AUDIO_PULSE_COOKIE}:/home/bluefin/.config/pulse/cookie:ro")
    elif [[ -n "$REVIEW_AUDIO_SND_DEVICE" ]]; then
      sif_args+=(--bind "${REVIEW_AUDIO_SND_DEVICE}:/dev/snd")
    fi
    [[ -z "$REVIEW_OMP_CONFIG_VOLUME" ]] ||
      sif_args+=(--bind "$REVIEW_OMP_CONFIG_VOLUME")
    sif_args+=("$selected_sif")
    sif_args+=("${PARSED_REVIEW_ARGS[@]}")
    exec apptainer "${sif_args[@]}"
  }

  if [[ -n "$sif" ]]; then
    launch_sif "$sif"
  fi

  if kvm_runtime_ready; then
    ensure_image "$image" "review appliance" "image/appliance/Containerfile" "BLUEFIN_REVIEW_IMAGE"
    report_podman_image_identity "$image" "review appliance"
    local -a podman_args=()
    podman_args+=(run --runtime=krun --rm --interactive --tty)
    podman_args+=(--name "$name")
    podman_args+=(--userns "keep-id:uid=65532,gid=65532")
    podman_args+=(--volume "${home}:/home/bluefin:rw,z")
    podman_args+=(--volume "${workspace}:/workspace:rw,z")
    podman_args+=(--volume "${scratch}:/tmp:rw,z")
    podman_args+=(--env GH_TOKEN --env GITHUB_TOKEN)
    podman_args+=(--env COPILOT_GITHUB_TOKEN --env GITHUB_COPILOT_TOKEN)
    podman_args+=(--env COPILOT_INTEGRATION_ID)
    podman_args+=(--env ANTHROPIC_API_KEY --env ANTHROPIC_OAUTH_TOKEN)
    podman_args+=(--env OPENAI_API_KEY --env GEMINI_API_KEY)
    podman_args+=(--env AWS_BEARER_TOKEN_BEDROCK --env AWS_REGION --env AWS_DEFAULT_REGION)
    podman_args+=(--env HIVE_HUB --env BLUEFIN_REVIEW_ORG)
    podman_args+=(--env BLUEFIN_REVIEW_PERSONAL_MODE --env BLUEFIN_REVIEW_SHOW_WORKFLOW_PRS)
    podman_args+=(--env "TERM=${TERM:-xterm-256color}")
    podman_args+=(--env "COLORTERM=${COLORTERM:-truecolor}")
    [[ -v BLUEFIN_REVIEW_INHERIT_OMP_CONFIG ]] &&
      podman_args+=(--env BLUEFIN_REVIEW_INHERIT_OMP_CONFIG)
    if [[ -n "$REVIEW_AUDIO_PULSE_SOCKET" ]]; then
      podman_args+=(--volume "${REVIEW_AUDIO_PULSE_SOCKET}:/run/bluefin/pulse/native:rw")
      [[ -z "$REVIEW_AUDIO_PULSE_COOKIE" ]] ||
        podman_args+=(--volume "${REVIEW_AUDIO_PULSE_COOKIE}:/home/bluefin/.config/pulse/cookie:ro")
      podman_args+=(--env "PULSE_SERVER=${REVIEW_AUDIO_PULSE_SERVER}")
    elif [[ -n "$REVIEW_AUDIO_SND_DEVICE" ]]; then
      podman_args+=(--device "$REVIEW_AUDIO_SND_DEVICE")
    fi
    [[ -z "$REVIEW_OMP_CONFIG_VOLUME" ]] ||
      podman_args+=(--volume "$REVIEW_OMP_CONFIG_VOLUME")
    podman_args+=("$image")
    podman_args+=("${PARSED_REVIEW_ARGS[@]}")
    exec "$engine" "${podman_args[@]}"
  fi

  if [[ -n "$fallback_sif" ]]; then
    launch_sif "$fallback_sif"
  fi
  require_fallback
  local apptainer_image="$image"
  [[ "$apptainer_image" == *://* ]] || apptainer_image="docker://${apptainer_image}"
  prepare_apptainer_environment
  [[ -z "$REVIEW_AUDIO_PULSE_SERVER" ]] ||
    export APPTAINERENV_PULSE_SERVER="$REVIEW_AUDIO_PULSE_SERVER"
  local -a apptainer_args=(run --containall --no-eval)
  apptainer_args+=("${APPTAINER_HOST_ARGS[@]}")
  apptainer_args+=(--home "${home}:/home/bluefin" --pwd /workspace --bind "${workspace}:/workspace,${scratch}:/tmp")
  if [[ -n "$REVIEW_AUDIO_PULSE_SOCKET" ]]; then
    apptainer_args+=(--bind "${REVIEW_AUDIO_PULSE_SOCKET}:/run/bluefin/pulse/native")
    [[ -z "$REVIEW_AUDIO_PULSE_COOKIE" ]] ||
      apptainer_args+=(--bind "${REVIEW_AUDIO_PULSE_COOKIE}:/home/bluefin/.config/pulse/cookie:ro")
  elif [[ -n "$REVIEW_AUDIO_SND_DEVICE" ]]; then
    apptainer_args+=(--bind "${REVIEW_AUDIO_SND_DEVICE}:/dev/snd")
  fi
  [[ -z "$REVIEW_OMP_CONFIG_VOLUME" ]] ||
    apptainer_args+=(--bind "$REVIEW_OMP_CONFIG_VOLUME")
  apptainer_args+=("$apptainer_image")
  apptainer_args+=("${PARSED_REVIEW_ARGS[@]}")
  exec apptainer "${apptainer_args[@]}"
}
run_contribute() {
  resolve_tokens
  [[ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]] || fail "no GitHub token available; run 'gh auth login' or export GH_TOKEN."
  [[ -z "${REVIEW_DETACH:-}" ]] || fail "detached contributor containers are not supported."
  (($# <= 1)) || fail "contribute accepts at most one instance name (for example, org/repo)."

  local instance="${1:-default}"
  [[ "$instance" =~ ^[A-Za-z0-9._/-]+$ ]] || fail "invalid contributor instance name: ${instance}"
  local registration="${HIVE_CONTRIBUTOR_ENV:-${HOME}/.config/hive/contributor.env}"
  if [[ $# -eq 1 && -z "${HIVE_CONTRIBUTOR_ENV:-}" ]]; then
    local registration_name="${instance//\//-}"
    local named="${HOME}/.config/hive/contributor.${registration_name}.env"
    [[ -r "$named" ]] || fail "Hive registration for ${instance} is missing: ${named}"
    registration="$named"
  fi
  [[ -r "$registration" ]] || fail "Hive registration is missing or unreadable: ${registration}"

  local key root home name image
  key="$(slugify "${BLUEFIN_INSTANCE:-contribute-$instance}")"
  root="${XDG_STATE_HOME:-${HOME}/.local/state}/bluefin/instances/${key}"
  home="${root}/home"
  name="bluefin-contribute-${key}-$(date +%s)-$$"
  image="${BLUEFIN_CONTRIBUTE_IMAGE:-ghcr.io/projectbluefin/contribute:stable}"
  mkdir -p "$home/workspace"

  if kvm_runtime_ready; then
    ensure_image "$image" "contributor" "image/contribute/Containerfile" "BLUEFIN_CONTRIBUTE_IMAGE"
    report_podman_image_identity "$image" "contributor"
    exec "$engine" run --runtime=krun --rm --interactive --tty \
      --name "$name" \
      --userns keep-id:uid=65532,gid=65532 \
      --volume "${home}:/home/bluefin:rw,z" \
      --volume "${registration}:/home/bluefin/.config/hive/contributor.env:ro,z" \
      --env AGENT_BACKEND=omp \
      --env GH_TOKEN --env GITHUB_TOKEN \
      --env COPILOT_GITHUB_TOKEN --env GITHUB_COPILOT_TOKEN \
      --env COPILOT_INTEGRATION_ID \
      --env ANTHROPIC_API_KEY --env ANTHROPIC_OAUTH_TOKEN \
      --env OPENAI_API_KEY --env GEMINI_API_KEY \
      --env AWS_BEARER_TOKEN_BEDROCK --env AWS_REGION --env AWS_DEFAULT_REGION \
      --env "HIVE_CONTAINER_NAME=${name}" --env HIVE_CONTAINER_RUNTIME=podman \
      --env "TERM=${TERM:-xterm-256color}" --env "COLORTERM=${COLORTERM:-truecolor}" \
      "$image"
  fi

  require_fallback
  local apptainer_image="$image"
  [[ "$apptainer_image" == *://* ]] || apptainer_image="docker://${apptainer_image}"
  prepare_apptainer_environment
  exec apptainer run --containall --no-eval "${APPTAINER_HOST_ARGS[@]}" \
    --home "${home}:/home/bluefin" \
    --pwd /home/bluefin/workspace \
    --bind "${registration}:/home/bluefin/.config/hive/contributor.env:ro" \
    "$apptainer_image"
}

case "$command_name" in
  review) run_review "$@" ;;
  contribute) run_contribute "$@" ;;
  *)
    echo "Usage: bluefin {review [org/repo|flags...]|contribute [instance]}" >&2
    exit 2
    ;;
esac
