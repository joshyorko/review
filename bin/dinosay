#!/usr/bin/env node
/**
 * dinosay — terminal ASCII dinosaur dialog generator.
 * Zero-dependency CLI compatible with dinosay/cowsay syntax.
 */

const DINOSAURS = {
	deino: [
		"                                                        .--.__",
		"                                                      .~ ($eye)  ~~~---_",
		"                                                     {     `-_~,,,,,,)",
		"                                                     {    (_  ',",
		"                                                      ~    . = _',",
		"                                                       ~-   '.  =-'",
		"                                                         ~     :",
		"      .                                             _,.-~     ('');",
		"      '.                                         .-~        \\  \\ ;",
		"        ':-_                                _.--~            \\  \\;      _-=,.",
		"          ~-:-.__                       _.-~                 {  '---- _'-=,.",
		"             ~-._~--._             __.-~                     ~---------=,.`",
		"                 ~~-._~~-----~~~~~~       .+++~~~~~~~~-__   /",
		"                      ~-.,____           {   -     +   }  _/",
		"                              ~~-.______{_    _ -=\\ / /_.~",
		"                                   :      ~--~    // /         ..-",
		"                                   :   / /      // /         ((",
		"                                   :  / /      {   `-------,. ))",
		"                                   :   /        ''=--------. }o",
		"                      .=._________,'  )                     ))",
		"                      )  _________ -''                     ~~",
		"                     / /  _ _",
		"                    (_.-.'O'-'.",
	],
	raptor: [
		"                     ___",
		"                    / o \\",
		"           _.----._/ /",
		"          /         /",
		"       __/ (  | (  |",
		"      /__.-'|_|--|_|",
	],
	stego: [
		"             __        _",
		"            /  \\      / )",
		"          _/    \\____/ /",
		"        _/             \\_",
		"       /                 \\",
		"     _/  _       _        \\",
		"    /   / \\     / \\        \\",
		"   /   /   \\   /   \\        \\",
		"  /   /     \\_/     \\        \\",
		" /___/               \\________\\",
		"      \\_   _/ \\_   _/",
		"        \\_/     \\_/",
	],
	dim: [
		"                                _._",
		"                              _/:|:",
		"                             /||||||.",
		"                             ||||||||.",
		"                            /|||||||||:",
		"                           /|||||||||||",
		"                          .|||||||||||||",
		"                          | ||||||||||||:",
		"                        _/| |||||||||||||:_=---.._",
		"                        | | |||||:'''':||  '~-._  '-.",
		"                      _/| | ||'         '-._   _:    ;",
		"                      | | | '               '~~     _;",
		"                      | '                _.=._    _-~",
		"                   _.~                  {     '-_'",
		"           _.--=.-~       _.._          {_       }",
		"       _.-~   ($eye)-,      {    '-._     _. '~==+  |",
		"      ('          }       \\_      \\_.=~       |  |",
		"      `,,,,,,,'  /_         ~-_    )         <_oo_>",
		"        `-----~~/ /'===...===' +   /",
		"               <_oo_>         /  //",
		"                             /  //",
		"                            <_oo_>",
	],
};

function formatBubble(text, width = 45) {
	const words = text.split(/\s+/);
	const lines = [];
	let current = "";

	for (const word of words) {
		if ((current + " " + word).trim().length <= width) {
			current = (current + " " + word).trim();
		} else {
			if (current) lines.push(current);
			current = word;
		}
	}
	if (current) lines.push(current);

	const maxLen = Math.max(...lines.map((l) => l.length), 10);
	const top = " " + "_".repeat(maxLen + 2);
	const bottom = " " + "-".repeat(maxLen + 2);

	const formatted = [top];
	if (lines.length === 1) {
		formatted.push(`< ${lines[0].padEnd(maxLen)} >`);
	} else {
		for (let i = 0; i < lines.length; i++) {
			const l = lines[i].padEnd(maxLen);
			if (i === 0) formatted.push(`/ ${l} \\`);
			else if (i === lines.length - 1) formatted.push(`\\ ${l} /`);
			else formatted.push(`| ${l} |`);
		}
	}
	formatted.push(bottom);
	formatted.push("        \\");
	formatted.push("         \\");
	return formatted;
}

function printDino(msg, dinoKey = "deino", eye = "O") {
	const template = DINOSAURS[dinoKey] ?? DINOSAURS.deino;
	const bubble = formatBubble(msg);
	const art = template.map((line) => line.replace("$eye", eye));
	console.log([...bubble, ...art].join("\n"));
}

const args = process.argv.slice(2);
let dino = "deino";
let message = "";

for (let i = 0; i < args.length; i++) {
	if (args[i] === "-d" || args[i] === "--dino") {
		dino = args[++i] || "deino";
	} else if (args[i] === "-l" || args[i] === "--list") {
		console.log("Available dinosaurs:", Object.keys(DINOSAURS).join(", "));
		process.exit(0);
	} else {
		message = (message + " " + args[i]).trim();
	}
}

if (!message) {
	message = "You eat 4x more food than I do. Efficient AF.";
}

printDino(message, dino);
