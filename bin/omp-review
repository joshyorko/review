#!/usr/bin/env bash
# Entrypoint for omp in dedicated Bluefin review / issues mode.
set -euo pipefail

# Check if a specific PR or issue argument is passed
if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
  TARGET_PR="$1"
  shift
  exec omp --extension /opt/bluefin/extensions/bluefin-review.ts "$@" \
    "Review exact pull request #${TARGET_PR} for projectbluefin. Inspect changes, check doctrine, security, correctness, and report findings."
fi

# Default: Launch interactive omp with lower-third dashboard widget & review mode enabled
exec omp --extension /opt/bluefin/extensions/bluefin-review.ts "$@"
