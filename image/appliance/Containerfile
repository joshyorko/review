# Review appliance.
#
# One image, one job: run the GitHub Review workbench in OMP. The user
# selects a repository or organization explicitly; no organization is implied.
# It derives from Project Bluefin's distroless FSDK base — glibc, CA
# certificates, tzdata, and the full terminfo database, no shell and no package
# manager — and adds the OMP and GitHub CLI artifacts plus the minimum Linux
# audio runtime closure. The shell, git, Python,
# and validator binaries are staged from FSDK; no package manager reaches the
# final image.
#
# A shell is present deliberately and is the single documented deviation from
# "distroless". omp's `bash` tool spawns one, and an agent that cannot run
# `gh pr checks` is not a review appliance. FSDK's own standard treats a shell
# as the named exception (`lab-runner`), and this image keeps that exception to
# one binary instead of a userland.
#
# Both pins below are tag *and* digest. The digest is what builds; the tag is
# what Renovate can compare against, and a pin no tool can track is a stale pin.

# renovate: datasource=docker depName=ghcr.io/projectbluefin/base
ARG FSDK_BASE_IMAGE=ghcr.io/projectbluefin/base:26.08@sha256:11754f1a31e4d36b2e917529dee66538c5594d7ee359cbf744c2297879e9fbd5
# The builder is the shell-enabled sibling of the same FSDK series, so the
# binaries staged out of it link against the base's own glibc.
# renovate: datasource=docker depName=ghcr.io/projectbluefin/lab-runner
ARG FSDK_BUILDER_IMAGE=ghcr.io/projectbluefin/lab-runner:26.08@sha256:7c4a93cb6c40d995af81d3ef705a874211883668cf504db3fb64ae3d72e12c9f
# Linux audio packages are absent from the FSDK runtime seam. The pinned audio
# stage contributes only the PulseAudio/ALSA libraries and configuration.
# renovate: datasource=docker depName=registry.fedoraproject.org/fedora-minimal
ARG AUDIO_BUILDER_IMAGE=registry.fedoraproject.org/fedora-minimal:46@sha256:35f36cc92b99eca31314b1268a6551be9522884d3fccfe6b73f82a5d7f217d72

# renovate: datasource=github-releases depName=can1357/oh-my-pi
ARG OMP_VERSION=18.5.0
ARG OMP_SOURCE_COMMIT=9348320cc4a30a7195d36a1f05a6c11bcb701a17
ARG OMP_SOURCE_SHA256=60ead7acc6185f5c06942d3f56d82dd0f41081e749f03b73547c6ed537407b46
ARG OMP_PATCH_SHA256=c4b7cc81811b17519d56865ab50e85675299a1f138dd08444f4173c202ce0a51
ARG OMP_BUN_VERSION=1.4.2
ARG OMP_BUN_X86_64_SHA256=c678040f14fe0440eb839d37cbd0ce4c051a32da72806ac97de6a6aab6bf728f
ARG OMP_BUN_AARCH64_SHA256=54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7
ARG NODE_VERSION=24.21.0
ARG NODE_X86_64_SHA256=6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff
ARG NODE_AARCH64_SHA256=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5
ARG OMP_NATIVES_VERSION=18.5.0
ARG OMP_NATIVES_X86_64_SHA512=1c433e06f82f9032222aace5272954c5f12071f5ae15ff6a642c8a2479efcef6e2b1d318c19bc53b34eabf437940d9d5910d35c0bb1ac9ceb16f4628f5396c94
ARG OMP_NATIVES_AARCH64_SHA512=61f5d765eb1619fbcd55d161f2c16bcbe29c4bb7da1edebcb4d839be4eca038bb3ffd2a7efc1ae7f496400e8056744ac0b5be121ab1afa90371226983d461ba5
ARG MEMORYD_SOURCE_COMMIT=e7f8d431797973afbdf4d0530aa14a25f43acf35
ARG MEMORYD_SOURCE_SHA256=155ec09537e941e4c71a65b738650b0419ae86f12cc86e28761d10553627d692
ARG TYPESAFE_VERSION=0.8.0
ARG TYPESAFE_SHA256=b9c7223c3793b1edf686205acb5d3cb8c2fa308ce0dadddfccb2caf75661534d
ARG TYPESAFE_SDK_VERSION=0.6.0
ARG TYPESAFE_SDK_SHA256=ccd94517c911c58ed5284b15838a001393e304ea3b784f6e8fb5a79f6365378e
ARG TYPESAFE_TYPEBOX_VERSION=1.3.34
ARG TYPESAFE_TYPEBOX_SHA256=58a270296bc4e185ee3a04328447a9ffa12e22ae6abaa31a03fd3273b800c7f0
# renovate: datasource=github-releases depName=cli/cli
ARG GH_VERSION=2.102.0
ARG GH_X86_64_SHA256=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
ARG GH_AARCH64_SHA256=7862c86c72f43df3a2d93ddde6f473285b4e2af61b494849846827e513ef6484

ARG REVIEW_VERSION=0.0.0
ARG REVIEW_REVISION=unknown
# ---------------------------------------------------------------- audio stage

FROM ${AUDIO_BUILDER_IMAGE} AS audio

COPY --chmod=0755 image/appliance/stage-audio.sh /usr/local/libexec/stage-audio
RUN microdnf --assumeyes --setopt=install_weak_deps=0 --nodocs install \
      pulseaudio-libs alsa-lib && \
    microdnf clean all && \
    /usr/local/libexec/stage-audio /audio-out \
      /usr/lib64/libpulse-simple.so.0 \
      /usr/lib64/libasound.so.2

# ---------------------------------------------------------------- build stage
FROM ${FSDK_BUILDER_IMAGE} AS build

ARG OMP_VERSION
ARG OMP_SOURCE_COMMIT
ARG OMP_SOURCE_SHA256
ARG OMP_PATCH_SHA256
ARG OMP_BUN_VERSION
ARG OMP_BUN_X86_64_SHA256
ARG OMP_BUN_AARCH64_SHA256
ARG NODE_VERSION
ARG NODE_X86_64_SHA256
ARG NODE_AARCH64_SHA256
ARG OMP_NATIVES_VERSION
ARG OMP_NATIVES_X86_64_SHA512
ARG OMP_NATIVES_AARCH64_SHA512
ARG MEMORYD_SOURCE_COMMIT
ARG MEMORYD_SOURCE_SHA256
ARG TYPESAFE_VERSION
ARG TYPESAFE_SHA256
ARG TYPESAFE_SDK_VERSION
ARG TYPESAFE_SDK_SHA256
ARG TYPESAFE_TYPEBOX_VERSION
ARG TYPESAFE_TYPEBOX_SHA256
ARG GH_VERSION
ARG GH_X86_64_SHA256
ARG GH_AARCH64_SHA256
ARG REVIEW_VERSION
ARG REVIEW_REVISION

# `SHELL` is ignored for the OCI image format, so every RUN sets its own shell
# options rather than trusting an instruction the builder drops on the floor.
#
# OMP is rebuilt from the pinned source on this native architecture. Every
# build input is checked before the derived executable is installed.
COPY --chmod=0755 scripts/build-derived-omp.sh /usr/local/libexec/build-derived-omp
COPY scripts/derived-omp-canary.ts /usr/local/libexec/derived-omp-canary.ts
COPY patches/omp/memory-backend-registration.patch /usr/local/share/bluefin/omp/memory-backend-registration.patch
RUN set -eu; \
    mkdir -p /out/usr/bin /out/usr/share/bluefin/review; \
    OMP_VERSION="$OMP_VERSION" \
    OMP_SOURCE_COMMIT="$OMP_SOURCE_COMMIT" \
    OMP_SOURCE_SHA256="$OMP_SOURCE_SHA256" \
    OMP_PATCH_SHA256="$OMP_PATCH_SHA256" \
    OMP_BUN_VERSION="$OMP_BUN_VERSION" \
    OMP_BUN_X86_64_SHA256="$OMP_BUN_X86_64_SHA256" \
    OMP_BUN_AARCH64_SHA256="$OMP_BUN_AARCH64_SHA256" \
    OMP_NATIVES_VERSION="$OMP_NATIVES_VERSION" \
    OMP_NATIVES_X86_64_SHA512="$OMP_NATIVES_X86_64_SHA512" \
    OMP_NATIVES_AARCH64_SHA512="$OMP_NATIVES_AARCH64_SHA512" \
    MEMORYD_SOURCE_COMMIT="$MEMORYD_SOURCE_COMMIT" \
    MEMORYD_SOURCE_SHA256="$MEMORYD_SOURCE_SHA256" \
    OMP_PATCH_PATH=/usr/local/share/bluefin/omp/memory-backend-registration.patch \
    OMP_OUTPUT_PATH=/out/usr/bin/omp \
    /usr/local/libexec/build-derived-omp; \
    omp_hash="$(sha256sum /out/usr/bin/omp)"; \
    printf '%s\n' "${omp_hash%% *}" > /out/usr/share/bluefin/review/omp-derived-sha256

RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) gh_arch=amd64; gh_sha="$GH_X86_64_SHA256" ;; \
      aarch64) gh_arch=arm64; gh_sha="$GH_AARCH64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    workdir="$(mktemp -d)"; \
    mkdir -p /out/usr/share/bluefin/review/pi-typesafe/node_modules/@typesafe-ai/sdk \
      /out/usr/share/bluefin/review/pi-typesafe/node_modules/typebox; \
    \
    curl --fail --location --show-error --silent \
      "https://registry.npmjs.org/pi-typesafe/-/pi-typesafe-${TYPESAFE_VERSION}.tgz" \
      -o "$workdir/pi-typesafe.tgz"; \
    echo "${TYPESAFE_SHA256}  $workdir/pi-typesafe.tgz" | sha256sum --check --status; \
    tar --no-same-owner --strip-components=1 -xzf "$workdir/pi-typesafe.tgz" \
      -C /out/usr/share/bluefin/review/pi-typesafe; \
    curl --fail --location --show-error --silent \
      "https://registry.npmjs.org/@typesafe-ai/sdk/-/sdk-${TYPESAFE_SDK_VERSION}.tgz" \
      -o "$workdir/typesafe-sdk.tgz"; \
    echo "${TYPESAFE_SDK_SHA256}  $workdir/typesafe-sdk.tgz" | sha256sum --check --status; \
    tar --no-same-owner --strip-components=1 -xzf "$workdir/typesafe-sdk.tgz" \
      -C /out/usr/share/bluefin/review/pi-typesafe/node_modules/@typesafe-ai/sdk; \
    curl --fail --location --show-error --silent \
      "https://registry.npmjs.org/typebox/-/typebox-${TYPESAFE_TYPEBOX_VERSION}.tgz" \
      -o "$workdir/typebox.tgz"; \
    echo "${TYPESAFE_TYPEBOX_SHA256}  $workdir/typebox.tgz" | sha256sum --check --status; \
    tar --no-same-owner --strip-components=1 -xzf "$workdir/typebox.tgz" \
      -C /out/usr/share/bluefin/review/pi-typesafe/node_modules/typebox; \
    test -f /out/usr/share/bluefin/review/pi-typesafe/package.json; \
    test -f /out/usr/share/bluefin/review/pi-typesafe/extensions/index.js; \
    test -f /out/usr/share/bluefin/review/pi-typesafe/node_modules/@typesafe-ai/sdk/package.json; \
    test -f /out/usr/share/bluefin/review/pi-typesafe/node_modules/typebox/package.json; \
    \
    curl --fail --location --show-error --silent \
      "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" \
      -o "$workdir/gh.tar.gz"; \
    echo "${gh_sha}  $workdir/gh.tar.gz" | sha256sum --check --status; \
    tar --no-same-owner -xf "$workdir/gh.tar.gz" -C "$workdir"; \
    install -m 0755 "$workdir/gh_${GH_VERSION}_linux_${gh_arch}/bin/gh" /out/usr/bin/gh; \
    \
    rm -rf "$workdir"

# The shell, git, review validators, and their library closure are staged from
# the pinned FSDK builder by an explicit allowlist. Nothing is installed into
# the final image; it is assembled from binaries already present at that seam.
COPY --chmod=0755 image/appliance/stage-runtime.sh /usr/local/libexec/stage-runtime
RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) node_arch=x64; node_sha="$NODE_X86_64_SHA256" ;; \
      aarch64) node_arch=arm64; node_sha="$NODE_AARCH64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    workdir="$(mktemp -d)"; \
    curl --fail --location --show-error --silent \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.gz" \
      -o "$workdir/node.tar.gz"; \
    echo "${node_sha}  $workdir/node.tar.gz" | sha256sum --check --status; \
    tar --no-same-owner --extract --gzip --file "$workdir/node.tar.gz" --directory "$workdir"; \
    node_dir="$workdir/node-v${NODE_VERSION}-linux-${node_arch}"; \
    install -D -m 0755 "$node_dir/bin/node" /usr/local/bin/node; \
    install -d -m 0755 /out/usr/lib/node_modules; \
    cp -a "$node_dir/lib/node_modules/npm" /out/usr/lib/node_modules/npm; \
    ln -s ../lib/node_modules/npm/bin/npm-cli.js /out/usr/bin/npm; \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /out/usr/bin/npx; \
    rm -rf "$workdir"
RUN /usr/local/libexec/stage-runtime /out \
    /usr/sbin/actionlint \
    /usr/sbin/shellcheck \
    /usr/sbin/yq \
    /usr/sbin/jq \
    /usr/sbin/just \
    /usr/sbin/openssl \
    /usr/local/bin/node \
    /usr/local/bin/bun
COPY --from=audio /audio-out/ /out/

# The in-image SBOM. syft can only see package-manager metadata, and every
# component of this image arrived as a release archive, so the archive
# provenance is recorded here or it is recorded nowhere.
COPY --chmod=0755 scripts/generate-appliance-sbom.py /usr/local/libexec/appliance-sbom
RUN arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) native_package=pi-natives-linux-x64; native_sha="$OMP_NATIVES_X86_64_SHA512"; gh_sha="$GH_X86_64_SHA256"; node_sha="$NODE_X86_64_SHA256"; bun_sha="$OMP_BUN_X86_64_SHA256" ;; \
      aarch64) native_package=pi-natives-linux-arm64; native_sha="$OMP_NATIVES_AARCH64_SHA512"; gh_sha="$GH_AARCH64_SHA256"; node_sha="$NODE_AARCH64_SHA256"; bun_sha="$OMP_BUN_AARCH64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out/usr/share/bluefin/review; \
    /usr/local/libexec/appliance-sbom \
      --arch "$arch" \
      --version "$REVIEW_VERSION" \
      --revision "$REVIEW_REVISION" \
      --omp-version "$OMP_VERSION" \
      --omp-sha256 "$(cat /out/usr/share/bluefin/review/omp-derived-sha256)" \
      --omp-source-commit "$OMP_SOURCE_COMMIT" \
      --omp-source-sha256 "$OMP_SOURCE_SHA256" \
      --omp-patch-sha256 "$OMP_PATCH_SHA256" \
      --omp-bun-version "$OMP_BUN_VERSION" \
      --node-version "$NODE_VERSION" \
      --node-sha256 "$node_sha" \
      --bun-sha256 "$bun_sha" \
      --omp-natives-version "$OMP_NATIVES_VERSION" \
      --omp-native-package "$native_package" \
      --omp-native-sha512 "$native_sha" \
      --gh-version "$GH_VERSION" \
      --gh-sha256 "$gh_sha" \
      --out /out/usr/share/bluefin/review/sbom.spdx.json; \
    rm /out/usr/share/bluefin/review/omp-derived-sha256; \
    python3 -m json.tool /out/usr/share/bluefin/review/sbom.spdx.json >/dev/null

# The mode itself, plus the identity files the base does not carry. FSDK's
# distroless base ships only a root entry; a numeric-only user with no passwd
# record breaks getpwuid(), which is exactly what a rootless runtime calls.
RUN set -eu; \
    install -d -m 0755 /out/etc /out/home/bluefin /out/workspace /out/run/bluefin/pulse; \
    printf 'root:x:0:0:root:/root:/usr/bin/bash\nbluefin:x:65532:65532:Bluefin Review:/home/bluefin:/usr/bin/bash\n' > /out/etc/passwd; \
    printf 'root:x:0:\nbluefin:x:65532:\n' > /out/etc/group; \
    chown -R 65532:65532 /out/home/bluefin /out/workspace

COPY image/appliance/config.yml /out/usr/share/bluefin/review/appliance-config.yml
COPY --chown=65532:65532 image/extension/bluefin-review /out/usr/share/bluefin/review/extension
COPY --chown=65532:65532 image/extension/luna-factory /out/usr/share/bluefin/review/luna-factory
# Luna's source tree imports Review helpers through ../bluefin-review. Keep the
# source sibling layout resolvable after the two packaged extensions are split
# into their runtime directories.
RUN ln -s extension /out/usr/share/bluefin/review/bluefin-review
COPY image/extension/typesafe-omp-loader.mjs /out/usr/share/bluefin/review/typesafe-omp-loader.mjs
COPY --chmod=0755 image/appliance/entrypoint.sh /out/usr/bin/bluefin-review-appliance
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64) audio_triplet=x86_64-linux-gnu ;; \
      aarch64) audio_triplet=aarch64-linux-gnu ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    for binary in /out/usr/bin/omp /out/usr/bin/gh /out/usr/bin/git /out/usr/bin/bash /out/usr/bin/python3 /out/usr/bin/node /out/usr/bin/bun /out/usr/bin/npm /out/usr/bin/npx; do \
      test -x "$binary" || { echo "missing $binary" >&2; exit 1; }; \
    done; \
    test -e "/out/usr/lib/${audio_triplet}/libpulse-simple.so.0"; \
    test -e "/out/usr/lib/${audio_triplet}/libasound.so.2"; \
    test -e /out/usr/share/alsa/alsa.conf; \
    test -e /out/usr/share/bluefin/review/extension/index.ts; \
    test -d /out/usr/share/bluefin/review/extension/agents; \
    test -e /out/usr/share/bluefin/review/luna-factory/index.ts; \
    test -e /out/usr/share/bluefin/review/luna-factory/omp/verifier-probe.ts; \
    test -d /out/usr/share/bluefin/review/luna-factory/agents; \
    test -L /out/usr/share/bluefin/review/bluefin-review; \
    test -e /out/usr/share/bluefin/review/bluefin-review/github.ts

# ---------------------------------------------------------------- final image

FROM ${FSDK_BASE_IMAGE}

ARG REVIEW_VERSION
ARG REVIEW_REVISION
ARG FSDK_BASE_IMAGE
ARG OMP_VERSION
ARG OMP_SOURCE_COMMIT
ARG OMP_PATCH_SHA256
ARG NODE_VERSION
ARG OMP_BUN_VERSION
ARG TYPESAFE_VERSION
ARG AUDIO_BUILDER_IMAGE

COPY --from=build /out /

ENV HOME=/home/bluefin \
    XDG_CONFIG_HOME=/home/bluefin/.config \
    XDG_CACHE_HOME=/home/bluefin/.cache \
    XDG_DATA_HOME=/home/bluefin/.local/share \
    XDG_STATE_HOME=/home/bluefin/.local/state \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=credential.https://github.com.helper \
    GIT_CONFIG_VALUE_0="!/usr/bin/gh auth git-credential" \
    PATH=/usr/bin:/bin \
    SHELL=/usr/bin/bash \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    BLUEFIN_REVIEW_APPLIANCE=1

LABEL org.opencontainers.image.title="Review" \
      org.opencontainers.image.description="GitHub Review workbench for OMP, packaged with Luna Factory." \
      org.opencontainers.image.source="https://github.com/joshyorko/review" \
      org.opencontainers.image.url="https://github.com/joshyorko/review" \
      org.opencontainers.image.documentation="https://github.com/joshyorko/review/blob/self-hosted/docs/appliance.md" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${REVIEW_VERSION}" \
      org.opencontainers.image.revision="${REVIEW_REVISION}" \
      org.opencontainers.image.base.name="${FSDK_BASE_IMAGE}" \
      io.github.joshyorko.review.appliance="true" \
      io.github.joshyorko.review.harness="omp" \
      io.github.joshyorko.review.omp.version="${OMP_VERSION}" \
      io.github.joshyorko.review.omp.source.commit="${OMP_SOURCE_COMMIT}" \
      io.github.joshyorko.review.node.version="${NODE_VERSION}" \
      io.github.joshyorko.review.bun.version="${OMP_BUN_VERSION}" \
      io.github.joshyorko.review.omp.patch.sha256="${OMP_PATCH_SHA256}" \
      io.github.joshyorko.review.typesafe.version="${TYPESAFE_VERSION}" \
      io.github.joshyorko.review.audio.source="${AUDIO_BUILDER_IMAGE}" \
      io.github.joshyorko.review.audio.packages="pulseaudio-libs,alsa-lib"

USER 65532:65532
WORKDIR /workspace

# The mode is keyboard driven and registers no slash commands; arguments passed
# to `podman run` land on omp itself, so `--pr 1284` and `--issues` work.
ENTRYPOINT ["/usr/bin/bluefin-review-appliance"]
