# ---------------------------------------------------------------- audio stage

FROM ${AUDIO_BUILDER_IMAGE} AS audio

COPY --chmod=0755 image/appliance/stage-audio.sh /usr/local/libexec/stage-audio
RUN microdnf --assumeyes --setopt=install_weak_deps=0 --nodocs install \
      pulseaudio-libs alsa-lib && \
    microdnf clean all && \
    /usr/local/libexec/stage-audio /audio-out \
      /usr/lib64/libpulse-simple.so.0 \
      /usr/lib64/libasound.so.2

# ---------------------------------------------------------------- build stage
FROM ${RUNTIME_BUILDER_IMAGE} AS build

RUN microdnf --assumeyes --setopt=install_weak_deps=0 --nodocs install \
      bash coreutils git-core curl diffutils findutils gawk grep gzip less glibc-common \
      sed tar xz python3 python3-libs bubblewrap ShellCheck yq jq just \
      openssl ca-certificates tzdata ncurses-term patch gcc-c++ make && \
    microdnf clean all

