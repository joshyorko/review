#!/usr/bin/env bash
# worktree-guard — run an agent command in an ephemeral git worktree and
# enforce hygiene: a run that leaves untracked or modified files behind is
# reported, purged, and failed, so low-tier agents cannot pollute the working
# copy they were handed.
#
#   worktree-guard [--repo <dir>] -- <command> [args…]
#
# The command runs with the worktree as its working directory. When
# bubblewrap is available and usable, the command additionally runs inside a
# bwrap sandbox: the host filesystem read-only, the worktree bind-mounted
# writable, and a private /tmp. When bwrap is absent (fsdk-containers#109),
# the worktree isolation still holds — hygiene is enforced
# either way, the sandbox is defense in depth.
#
# The agent's own exit status is preserved: a failing agent fails this
# wrapper with the same code, and a passing agent that littered fails with
# the hygiene error. The worktree is always removed, from OUTSIDE the
# worktree, whatever happened inside it.
set -euo pipefail

die() {
  printf 'worktree-guard: %s\n' "$1" >&2
  exit 2
}

repo="$PWD"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      repo="${2:?--repo needs a directory}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *) die "unknown option: $1 (usage: worktree-guard [--repo <dir>] -- <command> [args…])" ;;
  esac
done
[[ $# -gt 0 ]] || die "no command given after --"

git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $repo"

worktree="$(mktemp -d "${TMPDIR:-/tmp}/worktree-guard.XXXXXX")"
# shellcheck disable=SC2329 # invoked by the trap below
cleanup() {
  # Removal must run from outside the worktree: git refuses to remove the
  # worktree the current directory lives in.
  cd /
  git -C "$repo" worktree remove --force "$worktree" 2>/dev/null || rm -rf "$worktree"
  git -C "$repo" worktree prune 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# --detach: no throwaway branch to leak, and HEAD is exactly what the caller
# reviewed.
git -C "$repo" worktree add --detach "$worktree" HEAD >/dev/null

bwrap_usable() {
  command -v bwrap >/dev/null 2>&1 && bwrap --ro-bind / / true 2>/dev/null
}

status=0
if bwrap_usable; then
  # Order matters: the writable worktree bind must come after the read-only
  # root so it overlays it, and /dev, /proc, and a private /tmp keep ordinary
  # tools working inside the sandbox.
  bwrap \
    --ro-bind / / \
    --dev /dev \
    --proc /proc \
    --tmpfs /tmp \
    --bind "$worktree" "$worktree" \
    --chdir "$worktree" \
    -- "$@" || status=$?
else
  (cd "$worktree" && "$@") || status=$?
fi

litter="$(git -C "$worktree" status --porcelain)"
if [[ -n "$litter" ]]; then
  printf 'worktree-guard: the run left the worktree dirty:\n%s\n' "$litter" >&2
  printf 'worktree-guard: purging and failing the task.\n' >&2
  git -C "$worktree" clean -fdx >/dev/null
  git -C "$worktree" checkout -- . 2>/dev/null || true
  # Hygiene failure outranks a clean exit, but never masks the agent's own
  # failure code.
  [[ "$status" -eq 0 ]] && status=1
fi

exit "$status"
